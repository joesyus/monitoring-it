# Salin file ini menjadi .env lalu isi. Jangan bagikan file .env karena berisi kunci API.

# true = pakai data contoh (untuk mencoba tampilan dulu). Ubah ke false bila sumber sudah diisi.
MOCK=true

# Seberapa sering data ditarik ulang dari tiga sumber (menit)
REFRESH_MINUTES=15

# Login sederhana untuk dashboard (kosongkan bila tidak perlu)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# true = aktifkan /api/debug/raw/watun untuk melihat respons asli API Watun (matikan setelah selesai)
DEBUG=false

# ---------- Watun ----------
WATUN_BASE_URL=https://wa.farmedia.co.id
WATUN_TICKETS_PATH=/api/tickets
WATUN_API_KEY=
# Cara mengirim kunci. Contoh lain: header X-API-Key dengan skema kosong
WATUN_AUTH_HEADER=Authorization
WATUN_AUTH_SCHEME=Bearer
# true bila API membagi data per halaman (?page=1,2,3...)
WATUN_PAGED=false
WATUN_PAGE_PARAM=page
# Alamat tiket. Pakai {id} bila Watun punya halaman per tiket, misalnya https://wa.farmedia.co.id/ticketing/{id}
WATUN_TICKET_URL=https://wa.farmedia.co.id/ticketing

# ---------- OpenProject ----------
OPENPROJECT_URL=
# API token dari: My account > Access tokens > API
OPENPROJECT_API_KEY=
# Opsional: id atau identifier project (kosongkan untuk semua project yang bisa diakses token)
OPENPROJECT_PROJECT=

# ---------- ETOffice (lewat Google Sheet) ----------
# Google Sheet: File > Share > Publish to web > pilih tab data > format CSV > salin link-nya
ETO_SHEET_CSV_URL=
ETO_DEFAULT_CATEGORY=Hardware
